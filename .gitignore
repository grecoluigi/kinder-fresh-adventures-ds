# Source-only repository. Everything else is private or generated by default.
/*
!/.gitignore
!/README.md
!/VERSION
!/CHANGELOG.md
!/docs/
!/docs/*.md
!/docs/releases/
!/docs/releases/*.md
!/docs/images/
!/docs/images/jungle-framed.webp
!/.github/
!/.github/workflows/
!/.github/workflows/source-checks.yml
!/requirements-assets.txt
!/ds/
!/tools/

/ds/*
!/ds/Makefile
!/ds/README.md
!/ds/icon.png
!/ds/source/
!/ds/tests/
/ds/source/*
!/ds/source/*.c
!/ds/source/*.h
!/ds/source/*.inc
!/ds/source/*.s
!/ds/source/*.S
/ds/tests/*
!/ds/tests/*.c

/tools/*
!/tools/*.py
!/tools/PLAYTEST.md

# Local inputs, studies, dumps, generated assets, environments and build output.
/.local/
__pycache__/
*.pyc
.DS_Store

/docs/*
!/docs/*.md
!/docs/releases/
!/docs/images/
/docs/releases/*
!/docs/releases/*.md
/docs/images/*
!/docs/images/jungle-framed.webp
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/source-checks.yml
